# ============================================================
# config.env — Central configuration for the OTEL Agent Observability demo
# ============================================================
# Edit these values before running setup scripts.
# All scripts source this file automatically.
# ============================================================

# --- AWS Environment ---
export AWS_REGION="${AWS_REGION:-us-west-2}"
export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text 2>/dev/null)}"

# --- EKS Cluster ---
export EKS_CLUSTER_NAME="${EKS_CLUSTER_NAME:-otel-obs-$(openssl rand -hex 4)}"
export EKS_VERSION="${EKS_VERSION:-1.35}"

# --- Bedrock Models ---
export BEDROCK_PRIMARY_MODEL="${BEDROCK_PRIMARY_MODEL:-us.anthropic.claude-sonnet-5-v2-20260715}"
export BEDROCK_FALLBACK_MODEL="${BEDROCK_FALLBACK_MODEL:-us.anthropic.claude-haiku-4-5-20251001-v1:0}"

# --- Container Images ---
export ECR_REPO="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
export IMAGE_TAG="${IMAGE_TAG:-latest}"

# --- Bifrost ---
export BIFROST_IMAGE="${BIFROST_IMAGE:-maximhq/bifrost:latest}"

# --- GitOps ---
export GIT_REPO_URL="${GIT_REPO_URL:-https://github.com/aws-samples/containers-blog-maelstrom.git}"
export GIT_TARGET_REVISION="${GIT_TARGET_REVISION:-feature/agent-observability-patterns}"
