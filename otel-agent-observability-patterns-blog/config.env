# ============================================================
# config.env — Central configuration for the OTEL Agent Observability demo
# ============================================================
# Edit these values before running setup scripts.
# All scripts source this file automatically.
# ============================================================

# --- AWS Environment ---
export AWS_REGION="${AWS_REGION:-us-west-2}"
export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text 2>/dev/null)}"

# --- EKS Cluster ---
export EKS_CLUSTER_NAME="${EKS_CLUSTER_NAME:-otel-obs-$(openssl rand -hex 4)}"
export EKS_VERSION="${EKS_VERSION:-1.35}"

# --- Bedrock Models ---
export BEDROCK_PRIMARY_MODEL="${BEDROCK_PRIMARY_MODEL:-us.anthropic.claude-sonnet-5-v2-20260715}"
export BEDROCK_FALLBACK_MODEL="${BEDROCK_FALLBACK_MODEL:-us.anthropic.claude-haiku-4-5-20251001-v1:0}"

# --- Bifrost model alias (what agents request and what Langfuse records) ---
# This is the model string the agents send to Bifrost and that appears on the
# generation spans in Langfuse. The Langfuse model-price entry below is matched
# against this exact string so cost is computed per call / per agent.
export BIFROST_MODEL_ALIAS="${BIFROST_MODEL_ALIAS:-bedrock/us.anthropic.claude-sonnet-5}"

# --- Langfuse model pricing (per-token USD) ---
# setup-infra.sh registers a Langfuse model-price entry matching
# BIFROST_MODEL_ALIAS so Langfuse can compute cost (otherwise cost shows $0,
# because Langfuse has no built-in price for the Bifrost alias). Defaults are
# the published Amazon Bedrock Claude Sonnet on-demand rate: $2.20 / 1M input
# tokens and $11.00 / 1M output tokens. Adjust to match your model/region.
export MODEL_INPUT_PRICE_PER_TOKEN="${MODEL_INPUT_PRICE_PER_TOKEN:-0.0000022}"
export MODEL_OUTPUT_PRICE_PER_TOKEN="${MODEL_OUTPUT_PRICE_PER_TOKEN:-0.000011}"

# --- Container Images ---
export ECR_REPO="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
export IMAGE_TAG="${IMAGE_TAG:-latest}"

# --- Bifrost ---
export BIFROST_IMAGE="${BIFROST_IMAGE:-maximhq/bifrost:v1.6.10}"

# --- GitOps ---
export GIT_REPO_URL="${GIT_REPO_URL:-https://github.com/aws-samples/containers-blog-maelstrom.git}"
# Branch/ref ArgoCD syncs all workloads from. Defaults to main (the merged
# state). Override to a feature branch when testing unmerged changes:
#   export GIT_TARGET_REVISION=my-branch
export GIT_TARGET_REVISION="${GIT_TARGET_REVISION:-main}"
