{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Agent Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(agent_invoke_total[5m])) by (agent_name)",
          "legendFormat": "{{agent_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "Agent Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(agent_invoke_duration_seconds_bucket[5m])) by (le, agent_name))",
          "legendFormat": "p50 {{agent_name}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_invoke_duration_seconds_bucket[5m])) by (le, agent_name))",
          "legendFormat": "p95 {{agent_name}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(agent_invoke_duration_seconds_bucket[5m])) by (le, agent_name))",
          "legendFormat": "p99 {{agent_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Token Usage (Input vs Output)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(llm_token_count_input_total[5m])) by (agent_name)",
          "legendFormat": "input {{agent_name}}"
        },
        {
          "expr": "sum(rate(llm_token_count_output_total[5m])) by (agent_name)",
          "legendFormat": "output {{agent_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tokens/s"
        }
      }
    },
    {
      "title": "Estimated Cost per Agent ($/min)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(llm_token_count_input_total[5m])) by (agent_name) * 0.000003 + sum(rate(llm_token_count_output_total[5m])) by (agent_name) * 0.000015",
          "legendFormat": "{{agent_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "title": "Tool Call Success Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(tool_call_total{status=\"success\"}[5m])) / sum(rate(tool_call_total[5m])) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      }
    },
    {
      "title": "Tool Errors by Type",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(tool_call_total{status=\"error\"}[5m])) by (tool_name, error_type)",
          "legendFormat": "{{tool_name}} ({{error_type}})"
        }
      ]
    },
    {
      "title": "\u2500\u2500 Bifrost LLM Proxy Metrics \u2500\u2500",
      "type": "text",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "content": "## Bifrost LLM Proxy Metrics\nMetrics from the Bifrost gateway showing model routing, latency, and cost.",
        "mode": "markdown"
      }
    },
    {
      "title": "Bifrost: Request Rate by Model",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "sum(rate(bifrost_requests_total[5m])) by (model)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "Bifrost: Model Latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(bifrost_request_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "p95 {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Bifrost: Throttle/Fallback Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum(rate(bifrost_requests_total{status=\"throttled\"}[5m])) by (model)",
          "legendFormat": "throttled {{model}}"
        },
        {
          "expr": "sum(rate(bifrost_fallback_total[5m])) by (primary_model, fallback_model)",
          "legendFormat": "fallback {{primary_model}}\u2192{{fallback_model}}"
        }
      ]
    },
    {
      "title": "Bifrost: Token Throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum(rate(bifrost_tokens_total{direction=\"input\"}[5m])) by (model)",
          "legendFormat": "input {{model}}"
        },
        {
          "expr": "sum(rate(bifrost_tokens_total{direction=\"output\"}[5m])) by (model)",
          "legendFormat": "output {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tokens/s"
        }
      }
    }
  ],
